{
  "rewrites": [
    { "source": "/", "destination": "/weaid.html" },
    { "source": "/blog", "destination": "/weaid-blog.html" },
    { "source": "/login", "destination": "/weaid-login.html" },
    { "source": "/dashboard", "destination": "/weaid-user.html" },
    { "source": "/provider", "destination": "/weaid-provider.html" },
    { "source": "/admin", "destination": "/weaid-admin.html" },
    { "source": "/affiliate", "destination": "/weaid-affiliate.html" },
    { "source": "/post-job", "destination": "/weaid-post-job.html" },
    { "source": "/jobs", "destination": "/weaid-jobs.html" },
    { "source": "/directory", "destination": "/weaid-directory.html" },
    { "source": "/find", "destination": "/weaid-directory.html" },
    { "source": "/list-business", "destination": "/weaid-provider-signup.html" },
    { "source": "/p/:slug", "destination": "/weaid-provider-profile.html" },
    { "source": "/dashboard-pro", "destination": "/weaid-pro-dashboard.html" },
    { "source": "/ride", "destination": "/weaid-ride.html" },
    { "source": "/courier", "destination": "/weaid-ride.html?type=courier" },
    { "source": "/carpool", "destination": "/weaid-carpool.html" },
    { "source": "/food", "destination": "/weaid-food.html" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 9 * * *" },
    { "path": "/api/cron/booking-reminders", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/weekly-payout", "schedule": "0 6 * * 1" },
    { "path": "/api/cron/affiliate-month-end", "schedule": "0 8 1 * *" }
  ]
}
